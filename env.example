# ---------------------------------------------------------------------------
# teebo — variables d'environnement (copier vers .env)
# ---------------------------------------------------------------------------

# --- Base de données (PostgreSQL 16) ---
DATABASE_URL=postgres://teebo:teebo_change_me@localhost:5432/teebo

# --- Serveur ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=true

# --- Administrateur teebo (créé par `npm run migrate`) ---
TEEBO_ADMIN_EMAIL=hello@teebo.africa
TEEBO_ADMIN_PASSWORD=ChangezMoi#2026

# --- Coordonnées teebo (notifications) ---
TEEBO_WHATSAPP=+22650321432
TEEBO_EMAIL=hello@teebo.africa

# --- Google Sign-In (obligatoire en production) ---
GOOGLE_CLIENT_ID=

# --- WhatsApp Business Cloud API (optionnel : sinon mode dégradé) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- SMTP e-mail (optionnel : sinon mode dégradé) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=teebo <no-reply@teebo.africa>
